# Voice Agent SIP Integration — Environment Variables

# WebSocket URL of your Nova Sonic agent server
# For local dev: ws://host.docker.internal:8081/ws
# For production: wss://your-agent-server.internal/ws
AGENT_WS_URL=ws://host.docker.internal:8081/ws

# Public IP of this server (for RTP media)
# Set to your EC2 Elastic IP in production
PUBLIC_IP=

# Log level: debug, info, warn, error
LOG_LEVEL=info
