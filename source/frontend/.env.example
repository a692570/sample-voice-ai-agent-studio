# Cognito configuration — get these from the PreStack CloudFormation outputs
# Leave empty for local development (auth will be bypassed)
VITE_COGNITO_USER_POOL_ID=
VITE_COGNITO_CLIENT_ID=
VITE_COGNITO_IDENTITY_POOL_ID=

# Federated SSO (Midway) — leave empty to disable Midway login button
# Get the domain from PreStack output "CognitoDomain"
VITE_COGNITO_DOMAIN=
VITE_COGNITO_REDIRECT_URI=http://localhost:5173/callback

# AgentCore Runtime — get from AgentStack CloudFormation outputs
# Leave empty for local development (connects to localhost directly)
VITE_AGENTCORE_RUNTIME_ARN=
VITE_AWS_REGION=us-east-1

# AgentCore WebSocket URL — fallback for local dev when presigning is not configured
# For local dev: ws://localhost:8081/ws
VITE_AGENTCORE_WS_URL=ws://localhost:8081/ws

# Demos API URL — the CRUD API for saved demo configurations
VITE_API_URL=

# RAG API URL — Knowledge Base management API
VITE_RAG_API_URL=
